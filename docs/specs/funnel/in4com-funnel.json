{
  "v": 1,
  "stages": [
    {
      "code": "area0",
      "name": "Контакт до запроса",
      "role": "area0",
      "description": "Работа с целевой компанией: карта людей, касания до появления конкретной возможности. Зона отношений, а не стадия сделки.",
      "entryCondition": "Известна компания или человек; запроса и решения о продаже может не быть.",
      "signalsHint": "Знакомство, ответ на письмо, встреча на мероприятии, переход знакомого человека в другую компанию; новость или публичное упоминание как повод для контакта. Сохраняем контекст, гипотезу потребности, владельца отношений и следующий шаг. В прогноз не входит.",
      "inForecast": false,
      "probabilityMode": "stage",
      "probability": 0
    },
    {
      "code": "s1",
      "name": "Новая возможность",
      "role": "active",
      "description": "Конкретная потребность, запрос или подходящая закупка; первая оценка и решение go / no-go — условие входа в воронку.",
      "entryCondition": "У клиента есть конкретная задача, персональное приглашение или подходящая закупка, и мы решили участвовать (go).",
      "signalsHint": "Клиент описал задачу, пригласил к отбору или объявил конкурс с понятным предметом. Сигнал сохраняется сразу; после решения go создаётся сделка. Это ещё не подготовка решения и не прогноз.",
      "inForecast": false,
      "probabilityMode": "stage",
      "probability": 0
    },
    {
      "code": "s2",
      "name": "Запрошены материалы или решение",
      "role": "active",
      "description": "Квалификация нашей компании и запрос решения от клиента.",
      "entryCondition": "Клиент просит материалы для оценки нашей компании или предложение по конкретной задаче.",
      "signalsHint": "Кейсы, анкеты, документы или RFI в рамках отбора; бриф или RFP с просьбой предложить подход, концепцию, план или тестовое задание. Общая просьба «пришлите кейсы» без задачи остаётся касанием в зоне «Контакт до запроса».",
      "inForecast": false,
      "probabilityMode": "stage",
      "probability": 0
    },
    {
      "code": "s3",
      "name": "Финальный выбор",
      "role": "active",
      "description": "Шорт-лист и финальные условия.",
      "entryCondition": "Клиент подтвердил следующий тур или после рассмотрения решения обсуждает актуальные условия.",
      "signalsHint": "Подтверждён шорт-лист или финал; запрошена обновлённая смета; после представления решения обсуждаются объём, цена и условия закупки. Ранний вопрос о бюджете сам по себе стадию не меняет.",
      "inForecast": true,
      "probabilityMode": "expert",
      "probability": 0.3
    },
    {
      "code": "s4",
      "name": "Выбраны",
      "role": "active",
      "description": "Устный выбор и официальная победа.",
      "entryCondition": "Клиент прямо сообщил, что выбрал нас; обязательство заказать ещё не оформлено.",
      "signalsHint": "Сообщение о выборе от уполномоченного лица клиента или официальное уведомление о победе. Похвала решению или догадка сотрудника клиента — не выбор.",
      "inForecast": true,
      "probabilityMode": "expert",
      "probability": 0.7
    },
    {
      "code": "won",
      "name": "Заказ подтверждён",
      "role": "won",
      "description": "Подтверждённый заказ и передача в исполнение.",
      "entryCondition": "Клиент принял обязательство заказать согласованную работу.",
      "signalsHint": "Подписан договор или дополнение, оформлен обязательный заказ, принята оферта. Победа без подтверждённого заказа остаётся на стадии «Выбраны». Оплата — отдельный факт.",
      "inForecast": false,
      "probabilityMode": "stage",
      "probability": 1
    },
    {
      "code": "lost",
      "name": "Не состоялась",
      "role": "lost",
      "description": "Подтверждённый проигрыш или отмена закупки.",
      "entryCondition": "Клиент сообщил о выборе другого участника или об отмене закупки; причина указана.",
      "signalsHint": "Явный отказ, выбор другого участника, отмена закупки. Молчание клиента — не проигрыш.",
      "inForecast": false,
      "probabilityMode": "stage",
      "probability": 0
    }
  ],
